<resources>
    <style name="TopRoundedCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="RoundedFruitImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.SugarFruit.FruitDetailsButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/fruit_details_ripple</item>
    </style>
    <style name="Widget.SugarFruit.FormField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/sugarfruit_field_fill</item>
        <item name="boxStrokeColor">@color/sugarfruit_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/sugarfruit_text_secondary</item>
    </style>
    <style name="Widget.SugarFruit.DropdownField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/sugarfruit_field_fill</item>
        <item name="boxStrokeColor">@color/sugarfruit_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="endIconTint">@color/sugarfruit_text_secondary</item>
        <item name="hintTextColor">@color/sugarfruit_text_secondary</item>
    </style>
    <style name="Widget.SugarFruit.ProfileField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/profile_field_background</item>
        <item name="boxStrokeColor">@color/profile_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">15dp</item>
        <item name="boxCornerRadiusTopEnd">15dp</item>
        <item name="boxCornerRadiusBottomStart">15dp</item>
        <item name="boxCornerRadiusBottomEnd">15dp</item>
        <item name="hintEnabled">false</item>
    </style>
    <style name="Widget.SugarFruit.ProfileDropdownField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/profile_field_background</item>
        <item name="boxStrokeColor">@color/profile_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">15dp</item>
        <item name="boxCornerRadiusTopEnd">15dp</item>
        <item name="boxCornerRadiusBottomStart">15dp</item>
        <item name="boxCornerRadiusBottomEnd">15dp</item>
        <item name="endIconTint">@color/profile_text_primary</item>
        <item name="hintEnabled">false</item>
    </style>
    <style name="Widget.SugarFruit.SeasonChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fruit_season_chip_text</item>
        <item name="android:textSize">16sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/fruit_season_chip_background</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipMinHeight">48dp</item>
        <item name="chipStrokeColor">@color/fruit_season_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
    </style>
    <style name="TextAppearance.SugarFruit.ProfileSection" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/profile_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ShapeAppearance.SugarFruit.BottomNavigationIndicator" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="Widget.SugarFruit.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:color">@color/design_surface_subtle</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SugarFruit.BottomNavigationIndicator</item>
    </style>
    <style name="Widget.SugarFruit.SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="cardBackgroundColor">@color/design_surface</item>
        <item name="cardCornerRadius">17dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/design_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailSection" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/detail_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailRowLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/detail_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailMetricLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/detail_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailMetricValue" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/detail_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailAdvice" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:textColor">@color/detail_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.SugarFruit.DetailTip" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/detail_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.SugarFruit.DetailMetricColumn" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="Widget.SugarFruit.DetailMetricDivider" parent="">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/detail_divider</item>
    </style>
    <style name="Widget.SugarFruit.DetailAdviceRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="Widget.SugarFruit.DetailTipRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">top</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
