<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".App_page4">

    <ImageView
        android:id="@+id/detail_image"
        android:layout_width="0dp"
        android:layout_height="270dp"
        android:contentDescription="@string/fruit_image"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/q1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="200dp"
        app:cardBackgroundColor="@color/profile_field_background"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/TopRoundedCard">

        <ScrollView
            android:id="@+id/detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="30dp"
                android:paddingEnd="30dp"
                android:paddingBottom="36dp">

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:text="@string/detail_name_placeholder"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/logo_50"
                    tools:text="มะม่วง" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_safety_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_safety"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="15sp"
                    tools:text="🟡 ควรจำกัด" />

                <TextView
                    android:id="@+id/detail_introduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="มะม่วงมีคาร์โบไฮเดรต จึงควรนับรวมในแผนมื้ออาหารและควบคุมปริมาณต่อมื้อ"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/detail_recommendation_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/detail_recommended_amount_title"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_recommended_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="ประมาณครึ่งผลต่อครั้ง" />

                    <TextView
                        android:id="@+id/detail_recommended_equivalent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="14sp"
                        tools:text="1 ส่วน ให้คาร์โบไฮเดรตประมาณ 15 กรัม" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_nutrition_title"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_gi_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_index_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="41 (ต่ำ) ดีต่อผู้ป่วยเบาหวาน" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_carbohydrate_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_carbohydrate_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="15.0/100 กรัม (ปานกลาง) ช่วยรักษาระดับน้ำตาลในเลือด" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_fiber_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_fiber_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="1.6/100 กรัม (ต่ำ) ชะลอการดูดซึมน้ำตาลได้น้อย" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_impact_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_impact_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="🟡 ปานกลาง" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_diabetes_advice_title"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_type1_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_type1_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="สามารถกินได้ ถ้าคำนวณคาร์บและฉีดอินซูลินอย่างเหมาะสม" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_type2_short_label"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_type2_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp"
                    tools:text="สามารถกินได้ในปริมาณจำกัดเท่านั้น" />

                <LinearLayout
                    android:id="@+id/detail_general_advice_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/detail_general_advice_title"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_end_"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="14sp"
                        tools:text="• เลือกมะม่วงสดที่ไม่สุกงอมมาก และควบคุมปริมาณต่อมื้อ" />

                    <TextView
                        android:id="@+id/detail_tip_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="14sp"
                        tools:text="• จัดมะม่วงร่วมกับมื้อที่มีโปรตีนและผักไม่หวานตามหลักจานอาหาร" />

                    <TextView
                        android:id="@+id/detail_tip_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="14sp"
                        tools:text="• เลือกผลไม้ทั้งผลแทนน้ำผลไม้ และหลีกเลี่ยงผลไม้แปรรูปที่เติมน้ำตาล" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/detail_disclaimer"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/detail_source"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/button_Next"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="30dp"
                    android:text="@string/back"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
