<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/profileActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/profileActionIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:tint="@color/profile_text_primary"
            tools:src="@drawable/ic_profile_person" />

        <TextView
            android:id="@+id/profileActionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/profile_text_primary"
            android:textSize="15sp"
            tools:text="แก้ไขข้อมูลส่วนตัว" />

        <TextView
            android:id="@+id/profileActionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxWidth="100dp"
            android:maxLines="1"
            android:textColor="@color/profile_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="มาตรฐาน"
            tools:visibility="visible" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/profileActionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/dark_mode"
            android:minWidth="48dp"
            android:saveEnabled="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/profileActionChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_profile_chevron" />
    </LinearLayout>

    <View
        android:id="@+id/profileActionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="54dp"
        android:background="@color/profile_privacy_outline" />
</LinearLayout>
