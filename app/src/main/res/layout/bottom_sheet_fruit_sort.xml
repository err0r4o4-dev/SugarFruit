<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fruit_sort_sheet_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sort_sheet_title"
        android:textColor="@color/fruit_filter_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/sort_sheet_description"
        android:textColor="@color/fruit_filter_text_secondary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/sortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/sortSuitability"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/sort_option_suitability"
            android:textColor="@color/fruit_filter_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/sortName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/sort_option_name"
            android:textColor="@color/fruit_filter_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/sortDefault"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/sort_option_default"
            android:textColor="@color/fruit_filter_text_primary"
            android:textSize="16sp" />
    </RadioGroup>
</LinearLayout>
