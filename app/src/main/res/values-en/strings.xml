    <string name="banana_detail_evidence">The food-exchange list identifies one-half Hom banana or one Namwa banana as one fruit serving.</string>
    <string name="banana_detail_note">Banana includes several varieties. Match the portion to Hom or Namwa banana.</string>
    <string name="watermelon_detail_evidence">The food-exchange list identifies 6–8 bite-size watermelon pieces as one fruit serving.</string>
    <string name="papaya_detail_evidence">The food-exchange list identifies 6–8 bite-size ripe papaya pieces as one fruit serving.</string>
    <string name="papaya_detail_note">This portion applies to ripe papaya, not green papaya.</string>
    <string name="lychee_detail_evidence">The food-exchange list identifies 5–6 lychees as one fruit serving.</string>
    <string name="lychee_detail_note">This applies to fresh lychee, not canned lychee in syrup.</string>
    <string name="pineapple_detail_evidence">The food-exchange list identifies 6–8 bite-size pineapple pieces as one fruit serving.</string>
    <string name="pineapple_detail_note">This applies to fresh pineapple and does not include pineapple juice.</string>
    <string name="guava_detail_evidence">The food-exchange list identifies one-half medium guava as one fruit serving.</string>
    <string name="sweet_tamarind_detail_evidence">The food-exchange list identifies 2 sweet-tamarind fruits or pieces as one fruit serving.</string>
    <string name="sweet_tamarind_detail_note">Actual size may vary by sweet-tamarind variety.</string>
    <string name="jujube_detail_evidence">The food-exchange list identifies 4 jujubes as one fruit serving.</string>
    <string name="jujube_detail_note">This applies to fresh jujube, not dried Chinese jujube.</string>
    <string name="durian_detail_evidence">The food-exchange list identifies 1 small durian segment as one fruit serving.</string>
    <string name="durian_detail_note">A segment means one small section of durian flesh.</string>
    <string name="mangosteen_detail_evidence">The food-exchange list identifies 4 mangosteens as one fruit serving.</string>
    <string name="rambutan_detail_evidence">The food-exchange list identifies 4 rambutans as one fruit serving.</string>
    <string name="rambutan_detail_note">This applies to fresh rambutan, not canned rambutan.</string>
    <string name="longan_detail_evidence">The food-exchange list identifies 5–6 longans as one fruit serving.</string>
    <string name="longan_detail_note">This applies to fresh longan, not dried longan.</string>
    <string name="longkong_detail_evidence">The food-exchange list identifies 5–6 longkongs as one fruit serving.</string>
    <string name="pomelo_detail_evidence">The food-exchange list identifies 2 pomelo segments as one fruit serving.</string>
    <string name="apple_detail_evidence">The food-exchange list identifies 1 small apple as one fruit serving.</string>

    <string name="mango_detail_impact">Mango contains carbohydrate that affects blood glucose. Eat an appropriate portion and include it in the total carbohydrate for the meal.</string>
    <string name="mango_detail_type_1">Count mango carbohydrates with the meal and adjust insulin according to the care plan provided by your care team.</string>
    <string name="mango_detail_type_2">Eat it as part of a meal and control the total carbohydrate amount in that meal.</string>
    <string name="mango_detail_tip_1">Choose fresh mango that is not overly ripe and control the portion at each meal.</string>
    <string name="mango_detail_tip_2">Include mango in a meal with protein and non-starchy vegetables, following the plate method.</string>
    <string name="mango_detail_tip_3">Choose whole fruit instead of fruit juice and avoid processed fruit with added sugar.</string>

